DATABASE_URL=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://dtsc-platform.com
OPENROUTER_APP_TITLE=DTSC Platform
# JSON array of explicit DTSC-certified AiModelDefinition objects with providerCode OPENROUTER.
# No OpenRouter model is enabled by default and the remote catalog is never exposed directly to clients.
AI_OPENROUTER_CERTIFIED_MODELS_JSON=[]
# Network/catalog unavailability is only CI-blocking when explicitly enabled.
AI_OPENROUTER_CATALOG_AUDIT_STRICT=false

# MCP Gateway (server-only). Empty arrays mean no external MCP server/tool/resource is enabled.
# Keep credentials in dedicated secret env vars referenced by authEnvKey; never place tokens inside these JSON values.
DTSC_MCP_SERVERS_JSON=[]
DTSC_MCP_TOOL_BINDINGS_JSON=[]
DTSC_MCP_RESOURCE_BINDINGS_JSON=[]

AUTH_SECRET=
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_PUBLIC_URL=https://dtsc-platform.com
NEXT_PUBLIC_APP_URL=https://app.dtsc-platform.com
NEXT_PUBLIC_CONSOLE_URL=https://console.dtsc-platform.com
NEXT_PUBLIC_ACCOUNT_URL=https://account.dtsc-platform.com
NEXT_PUBLIC_SUPPORT_URL=https://support.dtsc-platform.com
# Set only in production when official subdomains share the same parent domain.
# AUTH_COOKIE_DOMAIN=.dtsc-platform.com
OPENAI_MODEL=gpt-5-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MODEL_IDS=gpt-5-nano,gpt-5-mini,gpt-4.1-mini
NEXT_PUBLIC_DEFAULT_MODEL=gpt-5-nano
ADMIN_EMAIL=
DEFAULT_ADMIN_EMAIL=admin@dtsc-platform.com
DEFAULT_ADMIN_PASSWORD=DtscAdmin2026!
DEFAULT_ADMIN_BOOTSTRAP_ENABLED=false
DTSC_CONTACT_EMAIL=contact@dtsc-platform.com
CONTACT_EMAIL=contact@dtsc-platform.com
ZOHO_MAIL_WEBHOOK_URL=
ZOHO_OUTBOUND_MAIL_WEBHOOK_URL=
ZOHO_OUTGOING_WEBHOOK_SECRET=
ZOHO_MAIL_API_BASE_URL=https://mail.zoho.com
ZOHO_ACCOUNTS_API_BASE_URL=https://accounts.zoho.com
ZOHO_MAIL_ACCOUNT_ID=
ZOHO_MAIL_FROM_ADDRESS=contact@dtsc-platform.com
ZOHO_MAIL_CLIENT_ID=
ZOHO_MAIL_CLIENT_SECRET=
ZOHO_MAIL_REFRESH_TOKEN=
MAISHAPAY_API_URL=https://marchand.maishapay.online/api/payment/rest/vers1.0/merchant
MAISHAPAY_GATEWAY_MODE=0
MAISHAPAY_PUBLIC_API_KEY=
MAISHAPAY_SECRET_API_KEY=
MAISHAPAY_DEFAULT_PROVIDER=MPESA
MAISHAPAY_CALLBACK_SECRET=

# Web Push (VAPID). Generate a P-256 VAPID key pair outside the repository.
# Only the public key may be exposed with NEXT_PUBLIC_. Never commit the private key.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:contact@dtsc-platform.com

# Optional, only if your OpenAI account/project requires them:
# OPENAI_ORGANIZATION=org_...
# OPENAI_PROJECT=proj_...

# Future integrations to configure only when the related modules are activated:
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=dtsc-documents
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
CRM_API_URL=
CRM_API_KEY=
