{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "sh vercel.sh",
  "ignoreCommand": "if [ \"${VERCEL_ENV:-}\" = \"production\" ]; then exit 1; else exit 0; fi",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  }
}
