{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "sh vercel.sh",
  "ignoreCommand": "if [ \"${VERCEL_ENV:-}\" = \"production\" ]; then exit 1; else exit 0; fi",
  "crons": [
    {
      "path": "/api/internal/workflows/process?batch=20",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/cross-module-projections/process?batch=20",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/identity-links/expire?batch=100",
      "schedule": "17 * * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false,
      "**": false
    }
  }
}