model EnterpriseLead {
  id                    String                  @id @default(cuid())
  organizationId        String
  reference             String
  partyType             String                  @default("PERSON")
  legalName             String
  displayName           String?
  normalizedName        String
  email                 String?
  phone                 String?
  companyName           String?
  source                String?
  status                String                  @default("NEW")
  ownerUserId           String?
  departmentId          String?
  businessPartyId       String?
  expectedValue         Decimal?                @db.Decimal(18, 2)
  currency              String?
  notes                 String?
  nextAction            String?
  nextActionAt          DateTime?
  convertedPartyId      String?
  convertedOpportunityId String?
  lostReason            String?
  createdByUserId       String
  updatedByUserId       String?
  revision              Int                     @default(1)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  contactedAt           DateTime?
  qualifiedAt           DateTime?
  convertedAt           DateTime?
  lostAt                DateTime?
  archivedAt            DateTime?
  convertedOpportunity  EnterpriseOpportunity?  @relation("EnterpriseLeadConvertedOpportunity", fields: [organizationId, convertedOpportunityId], references: [organizationId, id], onDelete: SetNull)
  businessParty         EnterpriseBusinessParty?  @relation(fields: [organizationId, businessPartyId], references: [organizationId, id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@unique([organizationId, reference])
  @@unique([organizationId, convertedOpportunityId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, ownerUserId, status])
  @@index([organizationId, normalizedName, status])
  @@index([organizationId, convertedPartyId])
  @@index([organizationId, businessPartyId, status])
  @@index([archivedAt])
}

model EnterpriseOpportunity {
  id                    String               @id @default(cuid())
  organizationId        String
  reference             String
  leadId                String?
  businessPartyId       String
  name                  String
  description           String?
  status                String               @default("OPEN")
  ownerUserId           String?
  departmentId          String?
  estimatedValue        Decimal?             @db.Decimal(18, 2)
  currency              String?
  probabilityPercent    Int                  @default(0)
  expectedCloseDate     DateTime?
  source                String?
  nextAction            String?
  nextActionAt          DateTime?
  wonAt                 DateTime?
  lostAt                DateTime?
  lostReason            String?
  closedAt              DateTime?
  notes                 String?
  createdByUserId       String
  updatedByUserId       String?
  revision              Int                  @default(1)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  archivedAt            DateTime?
  sourceLead            EnterpriseLead?      @relation("EnterpriseLeadConvertedOpportunity")
  quotes                EnterpriseQuote[]
  contracts             EnterpriseContract[]
  salesOrders           EnterpriseSalesOrder[]

  @@unique([organizationId, id])
  @@unique([organizationId, reference])
  @@index([organizationId, status, expectedCloseDate])
  @@index([organizationId, ownerUserId, status])
  @@index([organizationId, businessPartyId, status])
  @@index([organizationId, departmentId, status])
  @@index([archivedAt])
}

model EnterpriseQuote {
  id                    String                @id @default(cuid())
  organizationId        String
  reference             String
  opportunityId         String?
  businessPartyId       String
  title                 String
  description           String?
  status                String                @default("DRAFT")
  currency              String
  subtotalAmount        Decimal               @default(0) @db.Decimal(18, 2)
  discountAmount        Decimal               @default(0) @db.Decimal(18, 2)
  taxAmount             Decimal               @default(0) @db.Decimal(18, 2)
  totalAmount           Decimal               @default(0) @db.Decimal(18, 2)
  validUntil            DateTime?
  ownerUserId           String?
  terms                 String?
  sentAt                DateTime?
  acceptedAt            DateTime?
  rejectedAt            DateTime?
  expiredAt             DateTime?
  cancelledAt           DateTime?
  convertedAt           DateTime?
  convertedOrderId      String?
  createdByUserId       String
  updatedByUserId       String?
  revision              Int                   @default(1)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  archivedAt            DateTime?
  opportunity           EnterpriseOpportunity? @relation(fields: [organizationId, opportunityId], references: [organizationId, id], onDelete: SetNull)
  items                 EnterpriseQuoteItem[]
  convertedOrder        EnterpriseSalesOrder? @relation("EnterpriseQuoteConvertedOrder", fields: [organizationId, convertedOrderId], references: [organizationId, id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@unique([organizationId, reference])
  @@unique([organizationId, convertedOrderId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, businessPartyId, status])
  @@index([organizationId, opportunityId, status])
  @@index([organizationId, validUntil, status])
  @@index([archivedAt])
}

model EnterpriseQuoteItem {
  id                 String                @id @default(cuid())
  organizationId     String
  quoteId            String
  catalogItemId      String?
  description        String
  quantity           Decimal               @db.Decimal(18, 3)
  unitOfMeasureId    String?
  unitPrice          Decimal               @db.Decimal(18, 2)
  discountRate       Decimal               @default(0) @db.Decimal(8, 4)
  discountAmount     Decimal               @default(0) @db.Decimal(18, 2)
  taxRate            Decimal               @default(0) @db.Decimal(8, 4)
  taxAmount          Decimal               @default(0) @db.Decimal(18, 2)
  lineSubtotal       Decimal               @db.Decimal(18, 2)
  lineTotal          Decimal               @db.Decimal(18, 2)
  sortOrder          Int                   @default(0)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  quote              EnterpriseQuote       @relation(fields: [organizationId, quoteId], references: [organizationId, id], onDelete: Cascade)
  catalogItem        EnterpriseCatalogItem? @relation(fields: [organizationId, catalogItemId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, quoteId, sortOrder])
  @@index([organizationId, catalogItemId])
}

model EnterpriseContract {
  id                    String                 @id @default(cuid())
  organizationId        String
  reference             String
  businessPartyId       String
  opportunityId         String?
  quoteId               String?
  projectId             String?
  contractType          String
  title                 String
  description           String?
  status                String                 @default("DRAFT")
  ownerUserId           String?
  departmentId          String?
  startDate             DateTime?
  endDate               DateTime?
  indicativeAmount      Decimal?               @db.Decimal(18, 2)
  currency              String?
  renewalMode           String?                @default("NONE")
  renewalNoticeDays     Int?
  terms                 String?
  approvedAt            DateTime?
  activatedAt           DateTime?
  suspendedAt           DateTime?
  terminatedAt          DateTime?
  terminationReason     String?
  createdByUserId       String
  updatedByUserId       String?
  revision              Int                    @default(1)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  archivedAt            DateTime?
  opportunity           EnterpriseOpportunity? @relation(fields: [organizationId, opportunityId], references: [organizationId, id], onDelete: SetNull)
  salesOrders           EnterpriseSalesOrder[]
  projects              EnterpriseProject[]

  @@unique([organizationId, id])
  @@unique([organizationId, reference])
  @@index([organizationId, status, endDate])
  @@index([organizationId, businessPartyId, status])
  @@index([organizationId, opportunityId])
  @@index([organizationId, ownerUserId, status])
  @@index([archivedAt])
}

model EnterpriseSalesOrder {
  id                    String                        @id @default(cuid())
  organizationId        String
  reference             String
  businessPartyId       String
  opportunityId         String?
  quoteId               String?
  contractId            String?
  projectId             String?
  title                 String
  description           String?
  status                String                        @default("DRAFT")
  currency              String
  subtotalAmount        Decimal                       @default(0) @db.Decimal(18, 2)
  discountAmount        Decimal                       @default(0) @db.Decimal(18, 2)
  taxAmount             Decimal                       @default(0) @db.Decimal(18, 2)
  totalAmount           Decimal                       @default(0) @db.Decimal(18, 2)
  ownerUserId           String?
  departmentId          String?
  expectedFulfillmentAt DateTime?
  confirmedAt           DateTime?
  fulfilledAt           DateTime?
  closedAt              DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?
  createdByUserId       String
  updatedByUserId       String?
  revision              Int                           @default(1)
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  archivedAt            DateTime?
  opportunity           EnterpriseOpportunity?        @relation(fields: [organizationId, opportunityId], references: [organizationId, id], onDelete: SetNull)
  sourceQuote           EnterpriseQuote?              @relation("EnterpriseQuoteConvertedOrder")
  contract              EnterpriseContract?           @relation(fields: [organizationId, contractId], references: [organizationId, id], onDelete: SetNull)
  items                 EnterpriseSalesOrderItem[]
  fulfillments          EnterpriseFulfillment[]

  @@unique([organizationId, id])
  @@unique([organizationId, reference])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, businessPartyId, status])
  @@index([organizationId, opportunityId])
  @@index([organizationId, contractId])
  @@index([organizationId, expectedFulfillmentAt, status])
  @@index([archivedAt])
}

model EnterpriseSalesOrderItem {
  id                  String                     @id @default(cuid())
  organizationId      String
  salesOrderId        String
  catalogItemId       String?
  description         String
  quantityOrdered     Decimal                    @db.Decimal(18, 3)
  quantityFulfilled   Decimal                    @default(0) @db.Decimal(18, 3)
  unitOfMeasureId     String?
  unitPrice           Decimal                    @db.Decimal(18, 2)
  discountRate        Decimal                    @default(0) @db.Decimal(8, 4)
  discountAmount      Decimal                    @default(0) @db.Decimal(18, 2)
  taxRate             Decimal                    @default(0) @db.Decimal(8, 4)
  taxAmount           Decimal                    @default(0) @db.Decimal(18, 2)
  lineSubtotal        Decimal                    @db.Decimal(18, 2)
  lineTotal           Decimal                    @db.Decimal(18, 2)
  sortOrder           Int                        @default(0)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  salesOrder          EnterpriseSalesOrder       @relation(fields: [organizationId, salesOrderId], references: [organizationId, id], onDelete: Cascade)
  catalogItem         EnterpriseCatalogItem?      @relation(fields: [organizationId, catalogItemId], references: [organizationId, id], onDelete: Restrict)
  fulfillmentItems    EnterpriseFulfillmentItem[]

  @@unique([organizationId, id])
  @@index([organizationId, salesOrderId, sortOrder])
  @@index([organizationId, catalogItemId])
}

model EnterpriseFulfillment {
  id                    String                       @id @default(cuid())
  organizationId        String
  salesOrderId          String
  reference             String
  fulfillmentType       String
  status                String                       @default("DRAFT")
  warehouseId           String?
  fulfilledByUserId     String?
  fulfilledAt           DateTime?
  acceptedByCustomerAt  DateTime?
  acceptanceNotes       String?
  proofDocumentId       String?
  idempotencyKey        String?
  notes                 String?
  revision              Int                          @default(1)
  createdByUserId       String
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  salesOrder            EnterpriseSalesOrder         @relation(fields: [organizationId, salesOrderId], references: [organizationId, id], onDelete: Restrict)
  items                 EnterpriseFulfillmentItem[]

  @@unique([organizationId, id])
  @@unique([organizationId, reference])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, salesOrderId, status])
  @@index([organizationId, fulfilledAt])
}

model EnterpriseFulfillmentItem {
  id                  String                   @id @default(cuid())
  organizationId      String
  fulfillmentId       String
  salesOrderItemId    String
  quantityFulfilled   Decimal                  @db.Decimal(18, 3)
  notes               String?
  createdAt           DateTime                 @default(now())
  fulfillment         EnterpriseFulfillment    @relation(fields: [organizationId, fulfillmentId], references: [organizationId, id], onDelete: Cascade)
  salesOrderItem      EnterpriseSalesOrderItem @relation(fields: [organizationId, salesOrderItemId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, fulfillmentId, salesOrderItemId])
  @@index([organizationId, salesOrderItemId])
}
