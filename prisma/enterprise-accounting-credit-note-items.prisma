model EnterpriseSupplierCreditNoteItem {
  id                   String   @id @default(cuid())
  organizationId       String
  supplierCreditNoteId String
  catalogItemId        String?
  description          String
  quantity             Decimal  @db.Decimal(18, 6)
  unitPrice            Decimal  @db.Decimal(18, 6)
  netAmount            Decimal  @db.Decimal(18, 6)
  taxAmount            Decimal  @default(0) @db.Decimal(18, 6)
  totalAmount          Decimal  @db.Decimal(18, 6)
  createdAt            DateTime @default(now())

  @@unique([organizationId, id])
  @@index([organizationId, supplierCreditNoteId])
  @@index([organizationId, catalogItemId])
}
