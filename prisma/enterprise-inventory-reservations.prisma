model EnterpriseInventoryReservation {
  id                   String   @id @default(cuid())
  organizationId       String
  salesOrderId         String
  salesOrderItemId     String
  inventoryItemId      String
  warehouseId          String
  storageLocationId    String?
  quantity             Decimal  @db.Decimal(20, 6)
  fulfilledQuantity    Decimal  @default(0) @db.Decimal(20, 6)
  status               String   @default("ACTIVE")
  idempotencyKey       String
  expiresAt            DateTime?
  createdByUserId      String
  releasedByUserId     String?
  fulfilledByUserId    String?
  releasedAt           DateTime?
  fulfilledAt          DateTime?
  revision             Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, salesOrderId, status])
  @@index([organizationId, salesOrderItemId, status])
  @@index([organizationId, inventoryItemId, warehouseId, status])
  @@index([organizationId, expiresAt, status])
}
