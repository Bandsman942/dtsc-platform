model EnterpriseWorkflowDefinition {
  id                String                      @id @default(cuid())
  organizationId    String
  code              String
  name              String
  description       String?
  status            String                      @default("DRAFT")
  triggerType       String                      @default("MANUAL")
  triggerEntityType String?
  triggerEventType  String?
  allowManualStart  Boolean                     @default(false)
  singleActiveRun   Boolean                     @default(true)
  createdByUserId   String
  updatedByUserId   String?
  currentVersionId  String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  archivedAt        DateTime?
  versions          EnterpriseWorkflowVersion[]
  runs              EnterpriseWorkflowRun[]
  schedules         EnterpriseWorkflowSchedule[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, triggerEntityType, triggerEventType, status])
  @@index([archivedAt])
}

model EnterpriseWorkflowVersion {
  id                String                         @id @default(cuid())
  organizationId    String
  definitionId      String
  versionNumber     Int
  status            String                         @default("DRAFT")
  configurationJson Json?
  publishedAt       DateTime?
  publishedByUserId String?
  createdByUserId   String
  createdAt         DateTime                       @default(now())
  definition        EnterpriseWorkflowDefinition   @relation(fields: [organizationId, definitionId], references: [organizationId, id], onDelete: Cascade)
  steps             EnterpriseWorkflowStep[]
  transitions       EnterpriseWorkflowTransition[]
  runs              EnterpriseWorkflowRun[]
  schedules         EnterpriseWorkflowSchedule[]

  @@unique([organizationId, id])
  @@unique([organizationId, id, definitionId], map: "EW_Version_org_id_definition_key")
  @@unique([definitionId, versionNumber])
  @@index([organizationId, status, createdAt])
  @@index([definitionId, status])
}

model EnterpriseWorkflowStep {
  id                String                         @id @default(cuid())
  organizationId    String
  workflowVersionId String
  code              String
  name              String
  description       String?
  stepType          String
  position          Int
  configurationJson Json
  createdAt         DateTime                       @default(now())
  version           EnterpriseWorkflowVersion      @relation(fields: [organizationId, workflowVersionId], references: [organizationId, id], onDelete: Cascade)
  outgoing          EnterpriseWorkflowTransition[] @relation("WorkflowTransitionFrom")
  incoming          EnterpriseWorkflowTransition[] @relation("WorkflowTransitionTo")
  stepRuns          EnterpriseWorkflowStepRun[]

  @@unique([organizationId, id])
  @@unique([workflowVersionId, code])
  @@index([workflowVersionId, position])
  @@index([organizationId, stepType])
}

model EnterpriseWorkflowTransition {
  id                String                    @id @default(cuid())
  organizationId    String
  workflowVersionId String
  fromStepId        String
  toStepId          String
  outcome           String?
  priority          Int                       @default(0)
  conditionJson     Json?
  createdAt         DateTime                  @default(now())
  version           EnterpriseWorkflowVersion @relation(fields: [organizationId, workflowVersionId], references: [organizationId, id], onDelete: Cascade)
  fromStep          EnterpriseWorkflowStep    @relation("WorkflowTransitionFrom", fields: [organizationId, fromStepId], references: [organizationId, id], onDelete: Cascade)
  toStep            EnterpriseWorkflowStep    @relation("WorkflowTransitionTo", fields: [organizationId, toStepId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([workflowVersionId, fromStepId, outcome, priority])
  @@index([workflowVersionId, fromStepId, priority])
  @@index([workflowVersionId, toStepId])
}

model EnterpriseWorkflowRun {
  id                   String                       @id @default(cuid())
  organizationId       String
  workflowDefinitionId String
  workflowVersionId    String
  status               String                       @default("QUEUED")
  triggerType          String
  triggerEventId       String?
  sourceEntityType     String
  sourceEntityId       String
  currentStepId        String?
  resumeAt             DateTime?
  executionToken       String?
  executionLeaseUntil  DateTime?
  startedByUserId      String?
  decisionActorUserId  String?
  startedAt            DateTime                     @default(now())
  completedAt          DateTime?
  failedAt             DateTime?
  cancelledAt          DateTime?
  failureCategory      String?
  failureCode          String?
  failureMessage       String?
  revision             Int                          @default(1)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  definition           EnterpriseWorkflowDefinition @relation(fields: [organizationId, workflowDefinitionId], references: [organizationId, id], onDelete: Restrict)
  version              EnterpriseWorkflowVersion    @relation(fields: [organizationId, workflowVersionId], references: [organizationId, id], onDelete: Restrict)
  stepRuns             EnterpriseWorkflowStepRun[]
  events               EnterpriseWorkflowEvent[]
  approvals            EnterpriseApproval[]
  scheduledOccurrence  EnterpriseWorkflowScheduleOccurrence? @relation("ScheduledOccurrenceRun")

  @@unique([organizationId, id])
  @@unique([workflowDefinitionId, triggerEventId, sourceEntityType, sourceEntityId])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, workflowDefinitionId, startedAt])
  @@index([organizationId, sourceEntityType, sourceEntityId])
  @@index([resumeAt, status])
  @@index([status, executionLeaseUntil, updatedAt])
}

model EnterpriseWorkflowStepRun {
  id              String                            @id @default(cuid())
  organizationId  String
  workflowRunId   String
  workflowStepId  String
  status          String                            @default("PENDING")
  attemptCount    Int                               @default(0)
  assignedUserId  String?
  inputJson       Json?
  outputJson      Json?
  startedAt       DateTime?
  completedAt     DateTime?
  failedAt        DateTime?
  failureCategory String?
  failureCode     String?
  failureMessage  String?
  createdAt       DateTime                          @default(now())
  updatedAt       DateTime                          @updatedAt
  run             EnterpriseWorkflowRun             @relation(fields: [organizationId, workflowRunId], references: [organizationId, id], onDelete: Cascade)
  step            EnterpriseWorkflowStep            @relation(fields: [organizationId, workflowStepId], references: [organizationId, id], onDelete: Restrict)
  actionAttempts  EnterpriseWorkflowActionAttempt[]
  events          EnterpriseWorkflowEvent[]
  approvals       EnterpriseApproval[]

  @@unique([organizationId, id])
  @@unique([workflowRunId, workflowStepId])
  @@index([workflowRunId, status])
  @@index([workflowRunId, workflowStepId])
  @@index([organizationId, assignedUserId, status])
}

model EnterpriseWorkflowEvent {
  id             String                     @id @default(cuid())
  organizationId String
  workflowRunId  String
  stepRunId      String?
  eventType      String
  status         String?
  actorType      String                     @default("SYSTEM")
  actorUserId    String?
  summary        String
  metadataJson   Json?
  createdAt      DateTime                   @default(now())
  run            EnterpriseWorkflowRun      @relation(fields: [organizationId, workflowRunId], references: [organizationId, id], onDelete: Cascade)
  stepRun        EnterpriseWorkflowStepRun? @relation(fields: [organizationId, stepRunId], references: [organizationId, id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@index([workflowRunId, createdAt])
  @@index([stepRunId, createdAt])
  @@index([organizationId, eventType, createdAt])
}

model EnterpriseWorkflowActionAttempt {
  id               String                    @id @default(cuid())
  organizationId   String
  stepRunId        String
  actionType       String
  effectProtocol   String?
  idempotencyKey   String
  status           String                    @default("PENDING")
  attemptNumber    Int                       @default(1)
  resultEntityType String?
  resultEntityId   String?
  errorCategory    String?
  errorCode        String?
  errorMessage     String?
  startedAt        DateTime                  @default(now())
  completedAt      DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  stepRun          EnterpriseWorkflowStepRun @relation(fields: [organizationId, stepRunId], references: [organizationId, id], onDelete: Cascade)

  @@unique([idempotencyKey])
  @@unique([organizationId, id])
  @@index([stepRunId, status])
  @@index([organizationId, status, updatedAt])
}


/**
 * WF-06S1 inert durable scheduling registry. This is NOT an executable trigger.
 * No API/worker writes schedule rows until a separate reviewed activation.
 */
model EnterpriseWorkflowSchedule {
  id                   String                                 @id @default(cuid())
  organizationId       String
  workflowDefinitionId String
  workflowVersionId    String
  frequency            String
  timeZone             String
  hour                 Int
  minute               Int
  dayOfWeek            Int?
  status               String                                 @default("DISABLED")
  nextRunAt            DateTime?
  sourceEntityType     String?
  sourceEntityId       String?
  executionActorUserId String?
  mandateVerifiedAt    DateTime?
  createdByUserId      String
  revision             Int                                    @default(1)
  createdAt            DateTime                               @default(now())
  updatedAt            DateTime                               @updatedAt
  definition           EnterpriseWorkflowDefinition           @relation(fields: [organizationId, workflowDefinitionId], references: [organizationId, id], onDelete: Restrict, map: "EW_Schedule_definition_fkey")
  version              EnterpriseWorkflowVersion              @relation(fields: [organizationId, workflowVersionId, workflowDefinitionId], references: [organizationId, id, definitionId], onDelete: Restrict, map: "EW_Schedule_version_fkey")
  occurrences          EnterpriseWorkflowScheduleOccurrence[]

  @@unique([organizationId, id])
  @@unique([organizationId, id, workflowVersionId], map: "EW_Schedule_org_id_version_key")
  @@index([organizationId, status, nextRunAt])
  @@index([organizationId, workflowDefinitionId, status], map: "EW_Schedule_org_definition_status_idx")
  @@index([organizationId, sourceEntityType, sourceEntityId], map: "EW_Schedule_tenant_source_idx")
}

/**
 * Unique immutable local wall-clock reservation. No customer payload, source
 * entity, actor credentials or domain effect is stored on this record.
 */
model EnterpriseWorkflowScheduleOccurrence {
  id                String                     @id @default(cuid())
  organizationId    String
  scheduleId        String
  workflowVersionId String
  localDate         String
  localTime         String
  timeZone          String
  scheduledAt       DateTime
  occurrenceKey     String                     @unique(map: "EW_Occurrence_occurrence_key")
  status            String                     @default("RESERVED")
  // #850: the database CHECK prohibits using these fields before #843 activation.
  claimToken        String?
  leaseUntil        DateTime?
  attemptCount      Int                        @default(0)
  revision          Int                        @default(1)
  claimedAt         DateTime?
  completedAt       DateTime?
  lastFailureCode   String?
  workflowRunId     String?
  outboxEventId     String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @default(now()) @updatedAt
  schedule          EnterpriseWorkflowSchedule @relation(fields: [organizationId, scheduleId, workflowVersionId], references: [organizationId, id, workflowVersionId], onDelete: Restrict, map: "EW_Occurrence_schedule_fkey")
  run               EnterpriseWorkflowRun?     @relation("ScheduledOccurrenceRun", fields: [organizationId, workflowRunId], references: [organizationId, id], onDelete: Restrict, map: "EW_Occurrence_run_fkey")
  outboxEvent       EnterpriseDomainEvent?     @relation("ScheduledOccurrenceOutbox", fields: [organizationId, outboxEventId], references: [organizationId, id], onDelete: Restrict, map: "EW_Occurrence_outbox_fkey")

  @@unique([organizationId, id], map: "EW_Occurrence_org_id_key")
  @@unique([organizationId, scheduleId, workflowVersionId, localDate, localTime], map: "EW_Occurrence_org_schedule_version_local_key")
  @@unique([organizationId, workflowRunId], map: "EW_Occurrence_org_run_key")
  @@unique([organizationId, outboxEventId], map: "EW_Occurrence_org_outbox_key")
  @@index([organizationId, status, scheduledAt], map: "EW_Occurrence_org_status_due_idx")
  @@index([scheduleId, scheduledAt], map: "EW_Occurrence_schedule_due_idx")
  @@index([status, leaseUntil], map: "EW_Occurrence_status_lease_idx")
}

model EnterpriseDomainEvent {
  id               String   @id @default(cuid())
  organizationId   String
  eventType        String
  entityType       String
  entityId         String
  payloadJson      Json?
  idempotencyKey   String
  occurredAt       DateTime @default(now())
  processingStatus String   @default("PENDING")
  attemptCount     Int      @default(0)
  availableAt      DateTime @default(now())
  lockedAt         DateTime?
  lockedBy         String?
  processedAt      DateTime?
  lastError        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  scheduledOccurrence EnterpriseWorkflowScheduleOccurrence? @relation("ScheduledOccurrenceOutbox")

  @@unique([idempotencyKey])
  @@unique([organizationId, id])
  @@index([processingStatus, availableAt])
  @@index([organizationId, entityType, entityId, occurredAt])
  @@index([lockedAt, processingStatus])
}
