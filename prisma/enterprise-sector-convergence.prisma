model EnterpriseSectorSyncState {
  id                   String   @id @default(cuid())
  organizationId       String
  sector               String
  sourceEntityType     String
  sourceEntityId       String
  targetEntityType     String?
  targetEntityId       String?
  eventType            String   @default("ENTITY_MAPPING")
  eventVersion         Int      @default(1)
  idempotencyKey       String
  status               String   @default("PENDING")
  lastSyncedVersion    Int?
  errorCode            String?
  errorMessage         String?
  requiresManualAction Boolean  @default(false)
  cutoverComplete      Boolean  @default(false)
  metadataJson         Json?
  lastAttemptAt        DateTime?
  completedAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, sector, sourceEntityType, sourceEntityId, eventType, eventVersion])
  @@index([organizationId, sector, status, updatedAt])
  @@index([organizationId, requiresManualAction, status])
  @@index([organizationId, targetEntityType, targetEntityId])
}

model EnterpriseSectorCutoverState {
  id              String   @id @default(cuid())
  organizationId  String
  sector          String
  domainCode      String
  status          String   @default("DISABLED")
  featureFlag     String
  enabledByUserId String?
  enabledAt       DateTime?
  disabledByUserId String?
  disabledAt      DateTime?
  verifiedAt      DateTime?
  rollbackReason  String?
  notes           String?
  revision        Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, sector, domainCode])
  @@index([organizationId, status, updatedAt])
}

