model EnterpriseGamingConfiguration {
  id              String   @id @default(cuid())
  organizationId  String   @unique
  settingsJson    Json?
  revision        Int      @default(1)
  createdByUserId String
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
}

model EnterpriseGamingStationProfile {
  id              String   @id @default(cuid())
  organizationId  String
  assetId         String
  stationCode     String
  displayName     String?
  consoleFamily   String?
  maxPlayers      Int      @default(2)
  sortOrder       Int      @default(0)
  status          String   @default("AVAILABLE")
  notes           String?
  revision        Int      @default(1)
  createdByUserId String
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  archivedAt      DateTime?
  sessions        EnterpriseGamingSession[]
  bookings        EnterpriseGamingBooking[]
  pricingRules    EnterpriseGamingPricingRule[]

  @@unique([organizationId, id])
  @@unique([organizationId, assetId], map: "GamingStation_org_asset_key")
  @@unique([organizationId, stationCode], map: "GamingStation_org_code_key")
  @@index([organizationId, status, sortOrder])
  @@index([organizationId, consoleFamily, status])
  @@index([archivedAt])
}

model EnterpriseGamingBooking {
  id                String   @id @default(cuid())
  organizationId    String
  reference         String
  stationId         String
  businessPartyId   String?
  scheduledStartAt  DateTime
  scheduledEndAt    DateTime
  playerCount       Int      @default(1)
  status            String   @default("DRAFT")
  notes             String?
  confirmedAt       DateTime?
  checkedInAt       DateTime?
  noShowAt          DateTime?
  cancelledAt       DateTime?
  convertedAt       DateTime?
  idempotencyKey    String?
  revision          Int      @default(1)
  createdByUserId   String
  updatedByUserId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  archivedAt        DateTime?
  station           EnterpriseGamingStationProfile @relation(fields: [organizationId, stationId], references: [organizationId, id], onDelete: Restrict)
  session           EnterpriseGamingSession? @relation("GamingBookingSession")
  transitions       EnterpriseGamingBookingTransition[]

  @@unique([organizationId, id])
  @@unique([organizationId, reference], map: "GamingBooking_org_reference_key")
  @@unique([organizationId, idempotencyKey], map: "GamingBooking_org_idempotency_key")
  @@index([organizationId, stationId, status, scheduledStartAt])
  @@index([organizationId, businessPartyId, status])
  @@index([organizationId, status, scheduledStartAt])
  @@index([archivedAt])
}

model EnterpriseGamingBookingTransition {
  id             String   @id @default(cuid())
  organizationId String
  bookingId      String
  action         String
  idempotencyKey String
  fromStatus     String?
  toStatus       String
  actorUserId    String
  metadataJson   Json?
  occurredAt     DateTime @default(now())
  booking        EnterpriseGamingBooking @relation(fields: [organizationId, bookingId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, idempotencyKey], map: "GamingBookingTransition_org_idempotency_key")
  @@index([organizationId, bookingId, occurredAt])
  @@index([organizationId, action, occurredAt])
}

model EnterpriseGamingPricingRule {
  id                      String   @id @default(cuid())
  organizationId          String
  code                    String
  serviceCatalogItemId    String
  stationId               String?
  pricingMode             String
  amount                  Decimal  @db.Decimal(18, 2)
  currency                String
  durationMinutes         Int?
  billingIncrementMinutes Int?
  validFrom               DateTime?
  validUntil              DateTime?
  dayOfWeekMask           Int?
  startMinuteOfDay        Int?
  endMinuteOfDay          Int?
  priority                Int      @default(100)
  status                  String   @default("DRAFT")
  ruleJson                Json?
  revision                Int      @default(1)
  createdByUserId         String
  updatedByUserId         String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  archivedAt              DateTime?
  station                 EnterpriseGamingStationProfile? @relation(fields: [organizationId, stationId], references: [organizationId, id], onDelete: Restrict)
  sessions                EnterpriseGamingSession[]

  @@unique([organizationId, id])
  @@unique([organizationId, code], map: "GamingPricingRule_org_code_key")
  @@index([organizationId, serviceCatalogItemId, status])
  @@index([organizationId, stationId, status])
  @@index([organizationId, status, validFrom])
  @@index([archivedAt])
}

model EnterpriseGamingSession {
  id                   String   @id @default(cuid())
  organizationId       String
  reference            String
  stationId            String
  bookingId            String?
  businessPartyId      String?
  serviceCatalogItemId String?
  pricingRuleId        String?
  status               String   @default("WAITING")
  startedAt            DateTime?
  expectedEndAt        DateTime?
  pausedAt              DateTime?
  endedAt               DateTime?
  pausedSeconds         Int      @default(0)
  billableSeconds      Int?
  timingPolicyJson     Json?
  pricingSnapshotJson  Json?
  currency             String?
  quotedAmount         Decimal? @db.Decimal(18, 2)
  finalAmount          Decimal? @db.Decimal(18, 2)
  idempotencyKey       String?
  revision             Int      @default(1)
  createdByUserId      String
  updatedByUserId      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  archivedAt           DateTime?
  station              EnterpriseGamingStationProfile @relation(fields: [organizationId, stationId], references: [organizationId, id], onDelete: Restrict)
  booking              EnterpriseGamingBooking? @relation("GamingBookingSession", fields: [organizationId, bookingId], references: [organizationId, id], onDelete: Restrict)
  pricingRule          EnterpriseGamingPricingRule? @relation(fields: [organizationId, pricingRuleId], references: [organizationId, id], onDelete: Restrict)
  transitions          EnterpriseGamingSessionTransition[]
  checkout             EnterpriseGamingCheckout?

  @@unique([organizationId, id])
  @@unique([organizationId, reference], map: "GamingSession_org_reference_key")
  @@unique([organizationId, bookingId], map: "GamingSession_org_booking_key")
  @@unique([organizationId, idempotencyKey], map: "GamingSession_org_idempotency_key")
  @@index([organizationId, stationId, status, startedAt])
  @@index([organizationId, businessPartyId, status])
  @@index([organizationId, status, endedAt])
  @@index([organizationId, serviceCatalogItemId, status])
  @@index([archivedAt])
}

model EnterpriseGamingSessionTransition {
  id             String   @id @default(cuid())
  organizationId String
  sessionId      String
  action         String
  idempotencyKey String
  fromStatus     String?
  toStatus       String
  actorUserId    String
  metadataJson   Json?
  occurredAt     DateTime @default(now())
  session        EnterpriseGamingSession @relation(fields: [organizationId, sessionId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, idempotencyKey], map: "GamingSessionTransition_org_idempotency_key")
  @@index([organizationId, sessionId, occurredAt])
  @@index([organizationId, action, occurredAt])
}

model EnterpriseGamingCheckout {
  id                        String   @id @default(cuid())
  organizationId            String
  reference                 String
  sessionId                 String
  salesInvoiceId            String
  status                    String   @default("INVOICE_PENDING")
  idempotencyKey            String
  refundRequestedAt         DateTime?
  refundRequestedByUserId   String?
  refundReason              String?
  refundedAt                DateTime?
  createdByUserId           String
  updatedByUserId           String?
  revision                  Int      @default(1)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  session                   EnterpriseGamingSession @relation(fields: [organizationId, sessionId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, reference], map: "GamingCheckout_org_reference_key")
  @@unique([organizationId, sessionId], map: "GamingCheckout_org_session_key")
  @@unique([organizationId, salesInvoiceId], map: "GamingCheckout_org_invoice_key")
  @@unique([organizationId, idempotencyKey], map: "GamingCheckout_org_idempotency_key")
  @@index([organizationId, status, createdAt])
  @@index([organizationId, refundRequestedAt])
}

model EnterpriseGamingDailyClose {
  id                String   @id @default(cuid())
  organizationId    String
  reference         String
  businessDate      DateTime
  siteId            String?
  status            String   @default("SUBMITTED")
  submittedByUserId String
  validatedByUserId String?
  submittedAt       DateTime @default(now())
  validatedAt       DateTime?
  rejectedAt        DateTime?
  rejectionReason   String?
  notes             String?
  idempotencyKey    String
  revision          Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lines             EnterpriseGamingDailyCloseLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, reference], map: "GamingDailyClose_org_reference_key")
  @@unique([organizationId, idempotencyKey], map: "GamingDailyClose_org_idempotency_key")
  @@index([organizationId, businessDate, status])
  @@index([organizationId, siteId, businessDate])
}

model EnterpriseGamingDailyCloseLine {
  id                   String   @id @default(cuid())
  organizationId       String
  dailyCloseId         String
  financialAccountId   String
  methodType           String
  accountType          String
  currencyCode         String
  cashSessionId        String?
  paymentCount         Int      @default(0)
  expectedAmount       Decimal  @db.Decimal(20, 6)
  declaredAmount       Decimal  @db.Decimal(20, 6)
  differenceAmount     Decimal  @db.Decimal(20, 6)
  varianceReason       String?
  createdAt            DateTime @default(now())
  dailyClose           EnterpriseGamingDailyClose @relation(fields: [organizationId, dailyCloseId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, dailyCloseId, financialAccountId, methodType], map: "GamingDailyCloseLine_scope_key")
  @@index([organizationId, dailyCloseId])
  @@index([organizationId, financialAccountId, currencyCode])
  @@index([organizationId, cashSessionId])
}
