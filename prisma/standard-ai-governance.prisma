model AiModelCall {
  id                       String   @id @default(cuid())
  userId                   String
  organizationId           String?
  contextCode              String
  taskType                 String
  locale                   String   @default("fr")
  conversationId           String?
  enterpriseConversationId String?
  providerCode             String
  modelCode                String
  providerModelId          String
  strategyCode             String
  promptVersion            String?
  status                   String   @default("STARTED")
  reasonCode               String?
  fallbackUsed             Boolean  @default(false)
  retryCount               Int      @default(0)
  inputTokens              Int      @default(0)
  outputTokens             Int      @default(0)
  cachedInputTokens        Int      @default(0)
  totalTokens              Int      @default(0)
  estimatedCost            Decimal? @db.Decimal(14, 8)
  costCurrency             String?
  costKind                 String   @default("UNKNOWN")
  firstTokenLatencyMs      Int?
  durationMs               Int?
  metadataJson             Json?
  startedAt                DateTime @default(now())
  completedAt              DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([userId, organizationId, createdAt])
  @@index([organizationId, providerCode, modelCode, createdAt])
  @@index([conversationId, createdAt])
  @@index([enterpriseConversationId, createdAt])
  @@index([status, reasonCode, createdAt])
}

model CommercialMaturityEvidence {
  id             String   @id @default(cuid())
  moduleType     String
  moduleCode     String
  evidenceType   String
  title          String
  description    String?
  url            String?
  prNumber       Int?
  commitSha      String?
  productionId   String?
  ownerValidated Boolean  @default(false)
  metadataJson   Json?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([moduleType, moduleCode, createdAt])
  @@index([ownerValidated, createdAt])
  @@index([createdById, createdAt])
}

model CommercialMaturityTransition {
  id                     String   @id @default(cuid())
  moduleType             String
  moduleCode             String
  fromMaturity           String
  toMaturity             String
  status                 String   @default("APPLIED")
  reason                 String
  evidenceIdsJson        Json?
  criteriaSnapshotJson   Json?
  iterationCode          String?
  pullRequestNumber      Int?
  commitSha              String?
  productionDeploymentId String?
  e2eStatus              String   @default("NON_EXECUTED")
  ownerValidatedAt       DateTime?
  createdById            String
  idempotencyKey         String   @unique
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([moduleType, moduleCode, createdAt])
  @@index([toMaturity, status, createdAt])
  @@index([createdById, createdAt])
}
