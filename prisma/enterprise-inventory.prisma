model EnterpriseInventoryItem {
  id                 String                          @id @default(cuid())
  organizationId     String
  catalogItemId      String
  status             String                          @default("ACTIVE")
  minimumQuantity    Decimal?                        @db.Decimal(21, 6)
  reorderQuantity    Decimal?                        @db.Decimal(21, 6)
  allowNegativeStock Boolean                         @default(false)
  lotTracking        Boolean                         @default(false)
  expiryTracking     Boolean                         @default(false)
  createdByUserId    String
  updatedByUserId    String?
  revision           Int                             @default(1)
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt
  archivedAt         DateTime?
  catalogItem        EnterpriseCatalogItem           @relation(fields: [organizationId, catalogItemId], references: [organizationId, id], onDelete: Restrict)
  balances           EnterpriseInventoryBalance[]
  stockLots          EnterpriseStockLot[]
  stockMovements     EnterpriseStockMovement[]
  inventoryCountLines EnterpriseInventoryCountLine[]
  transferLines      EnterpriseStockTransferLine[]
  adjustments        EnterpriseStockAdjustment[]

  @@unique([organizationId, id])
  @@unique([organizationId, catalogItemId])
  @@index([organizationId, status])
  @@index([organizationId, minimumQuantity])
  @@index([archivedAt])
}

model EnterpriseStockLot {
  id                String                       @id @default(cuid())
  organizationId    String
  inventoryItemId   String
  lotNumber         String
  productionDate    DateTime?
  expiryDate        DateTime?
  supplierId        String?
  warehouseId       String
  storageLocationId String?
  status            String                       @default("AVAILABLE")
  qualityReason     String?
  qualityChangedByUserId String?
  qualityChangedAt  DateTime?
  recallReference   String?
  notes             String?
  createdByUserId   String
  revision          Int                          @default(1)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  archivedAt        DateTime?
  inventoryItem     EnterpriseInventoryItem      @relation(fields: [organizationId, inventoryItemId], references: [organizationId, id], onDelete: Restrict)
  storageLocation   EnterpriseStorageLocation?   @relation(fields: [organizationId, storageLocationId], references: [organizationId, id], onDelete: Restrict)
  balances          EnterpriseInventoryBalance[]
  movements         EnterpriseStockMovement[]

  @@unique([organizationId, id])
  // A physical batch may exist in multiple stores at once; each local lot
  // retains its original batch number and expiry while balances remain isolated.
  @@unique([organizationId, inventoryItemId, warehouseId, lotNumber])
  @@index([organizationId, warehouseId, status])
  @@index([organizationId, storageLocationId, status])
  @@index([organizationId, expiryDate, status])
  @@index([organizationId, inventoryItemId, lotNumber, recallReference], map: "stock_lot_recall_lookup_idx")
  @@index([organizationId, supplierId])
  @@index([archivedAt])
}

model EnterpriseInventoryBalance {
  id                String                     @id @default(cuid())
  organizationId    String
  inventoryItemId   String
  warehouseId       String
  storageLocationId String?
  stockLotId        String?
  quantityOnHand    Decimal                    @default(0) @db.Decimal(21, 6)
  quantityReserved  Decimal                    @default(0) @db.Decimal(21, 6)
  revision          Int                        @default(1)
  updatedAt         DateTime                   @updatedAt
  inventoryItem     EnterpriseInventoryItem    @relation(fields: [organizationId, inventoryItemId], references: [organizationId, id], onDelete: Restrict)
  warehouse         EnterpriseWarehouse        @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  storageLocation   EnterpriseStorageLocation? @relation(fields: [organizationId, storageLocationId], references: [organizationId, id], onDelete: Restrict)
  stockLot          EnterpriseStockLot?        @relation(fields: [organizationId, stockLotId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, inventoryItemId, warehouseId, storageLocationId, stockLotId])
  @@index([organizationId, warehouseId, inventoryItemId])
  @@index([organizationId, storageLocationId, inventoryItemId])
  @@index([organizationId, stockLotId])
}

model EnterpriseStockMovement {
  id                  String                     @id @default(cuid())
  organizationId      String
  inventoryItemId     String
  warehouseId         String
  storageLocationId   String?
  stockLotId          String?
  movementType        String
  direction           String
  quantity            Decimal                    @db.Decimal(21, 6)
  balanceAfter         Decimal?                   @db.Decimal(21, 6)
  occurredAt           DateTime                   @default(now())
  sourceEntityType     String?
  sourceEntityId       String?
  sourceLineId         String?
  idempotencyKey       String
  reason               String?
  createdByUserId      String
  createdAt            DateTime                   @default(now())
  inventoryItem        EnterpriseInventoryItem    @relation(fields: [organizationId, inventoryItemId], references: [organizationId, id], onDelete: Restrict)
  warehouse            EnterpriseWarehouse        @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  storageLocation      EnterpriseStorageLocation? @relation(fields: [organizationId, storageLocationId], references: [organizationId, id], onDelete: Restrict)
  stockLot             EnterpriseStockLot?        @relation(fields: [organizationId, stockLotId], references: [organizationId, id], onDelete: Restrict)
  returnCustodyEntries EnterpriseInventoryReturnCustody[]
  inventoryTransferDispatch EnterpriseInventoryTransferValuation? @relation("InventoryTransferDispatchMovement")
  inventoryTransferReceipt EnterpriseInventoryTransferValuation? @relation("InventoryTransferReceiptMovement")

  @@unique([organizationId, id])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, inventoryItemId, occurredAt])
  @@index([organizationId, warehouseId, occurredAt])
  @@index([organizationId, storageLocationId, occurredAt])
  @@index([organizationId, stockLotId, occurredAt])
  @@index([organizationId, movementType, occurredAt])
  @@index([organizationId, sourceEntityType, sourceEntityId])
}

model EnterpriseInventoryCount {
  id                String                         @id @default(cuid())
  organizationId    String
  reference         String
  warehouseId       String
  storageLocationId String?
  status            String                         @default("DRAFT")
  countType         String                         @default("FULL")
  plannedAt         DateTime?
  startedAt         DateTime?
  submittedAt       DateTime?
  approvedAt        DateTime?
  completedAt       DateTime?
  requestedByUserId String
  approvedByUserId  String?
  notes             String?
  revision          Int                            @default(1)
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  archivedAt        DateTime?
  lines             EnterpriseInventoryCountLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, reference])
  @@index([organizationId, warehouseId, status])
  @@index([organizationId, storageLocationId, status])
  @@index([organizationId, plannedAt, status])
  @@index([archivedAt])
}

model EnterpriseInventoryCountLine {
  id                 String                   @id @default(cuid())
  organizationId     String
  inventoryCountId   String
  inventoryItemId    String
  stockLotId         String?
  expectedQuantity   Decimal                  @db.Decimal(21, 6)
  countedQuantity    Decimal?                 @db.Decimal(21, 6)
  varianceQuantity   Decimal?                 @db.Decimal(21, 6)
  countedByUserId    String?
  countedAt          DateTime?
  notes              String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  inventoryCount     EnterpriseInventoryCount @relation(fields: [organizationId, inventoryCountId], references: [organizationId, id], onDelete: Cascade)
  inventoryItem      EnterpriseInventoryItem  @relation(fields: [organizationId, inventoryItemId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, inventoryCountId, inventoryItemId, stockLotId])
  @@index([organizationId, inventoryItemId])
  @@index([organizationId, stockLotId])
}

model EnterpriseStockTransfer {
  id                     String                        @id @default(cuid())
  organizationId         String
  reference              String
  sourceWarehouseId      String
  destinationWarehouseId String
  status                 String                        @default("DRAFT")
  requestedByUserId      String
  approvedByUserId       String?
  dispatchedByUserId     String?
  receivedByUserId       String?
  requestedAt            DateTime                      @default(now())
  approvedAt             DateTime?
  dispatchedAt           DateTime?
  receivedAt             DateTime?
  cancelledAt            DateTime?
  notes                  String?
  revision               Int                           @default(1)
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  archivedAt             DateTime?
  sourceWarehouse        EnterpriseWarehouse           @relation("EnterpriseStockTransferSource", fields: [organizationId, sourceWarehouseId], references: [organizationId, id], onDelete: Restrict)
  destinationWarehouse   EnterpriseWarehouse           @relation("EnterpriseStockTransferDestination", fields: [organizationId, destinationWarehouseId], references: [organizationId, id], onDelete: Restrict)
  lines                  EnterpriseStockTransferLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, reference])
  @@index([organizationId, sourceWarehouseId, status])
  @@index([organizationId, destinationWarehouseId, status])
  @@index([organizationId, requestedAt, status])
  @@index([archivedAt])
}

model EnterpriseStockTransferLine {
  id                   String                    @id @default(cuid())
  organizationId       String
  stockTransferId      String
  inventoryItemId      String
  stockLotId           String?
  sourceLocationId     String?
  destinationLocationId String?
  quantity             Decimal                   @db.Decimal(21, 6)
  createdAt            DateTime                  @default(now())
  stockTransfer        EnterpriseStockTransfer   @relation(fields: [organizationId, stockTransferId], references: [organizationId, id], onDelete: Cascade)
  inventoryItem        EnterpriseInventoryItem   @relation(fields: [organizationId, inventoryItemId], references: [organizationId, id], onDelete: Restrict)
  inventoryValuation EnterpriseInventoryTransferValuation?

  @@unique([organizationId, id])
  @@index([organizationId, stockTransferId])
  @@index([organizationId, inventoryItemId])
  @@index([organizationId, stockLotId])
}

model EnterpriseStockAdjustment {
  id                String                  @id @default(cuid())
  organizationId    String
  reference         String
  inventoryItemId   String
  warehouseId       String
  storageLocationId String?
  stockLotId        String?
  adjustmentType    String
  lossReason        String?
  quantity          Decimal                 @db.Decimal(21, 6)
  reason             String
  status             String                  @default("DRAFT")
  requestedByUserId String
  approvedByUserId  String?
  idempotencyKey    String?
  submittedAt       DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  appliedAt         DateTime?
  revision          Int                     @default(1)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  inventoryItem     EnterpriseInventoryItem @relation(fields: [organizationId, inventoryItemId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, reference])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, inventoryItemId, status])
  @@index([organizationId, warehouseId, status])
  @@index([organizationId, requestedByUserId, status])
}



 // Supplier return request/approval is not a stock movement or credit note.
 // Preserve the exact original receipt, valuation and invoice evidence.
model EnterpriseSupplierReturnRequest {
  id                      String @id @default(cuid())
  organizationId          String
  reference               String
  purchaseId              String
  receiptId               String
  receiptItemId           String
  sourceMovementId        String
  inventoryItemId         String
  warehouseId             String
  storageLocationId       String?
  stockLotId              String
  supplierId              String
  supplierInvoiceId       String
  supplierInvoiceItemId   String
  receiptAccountingEventId String
  originCostLayerId       String
  quantity                Decimal @db.Decimal(21, 6)
  unitCost                Decimal @db.Decimal(20, 6)
  totalCost               Decimal @db.Decimal(20, 6)
  recoverableTaxAmount    Decimal @default(0) @db.Decimal(20, 6)
  currencyCode            String
  reason                  String
  requestedByUserId       String
  status                  String @default("PENDING_APPROVAL")
  idempotencyKey          String
  revision                Int @default(1)
  decidedAt               DateTime?
  dispatchedAt            DateTime?
  dispatchedByUserId      String?
  dispatchReference       String?
  dispatchMovementId      String?
  dispatchAccountingEventId String?
  supplierCreditNoteId     String?
  supplierCreditReference  String?
  reconciledAt             DateTime?
  reconciledByUserId       String?
  creditJournalEntryId     String?
  cancelledAfterApprovalAt DateTime?
  cancelledAfterApprovalByUserId String?
  cancellationReason       String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  creditReplacements      EnterpriseSupplierReturnCreditReplacement[]

  @@unique([organizationId, id], map: "supplier_return_org_id_key")
  @@unique([organizationId, reference], map: "supplier_return_reference_key")
  @@unique([organizationId, idempotencyKey], map: "supplier_return_idempotency_key")
  @@unique([organizationId, dispatchMovementId], map: "supplier_return_dispatch_movement_key")
  @@unique([organizationId, dispatchAccountingEventId], map: "supplier_return_dispatch_event_key")
  @@unique([organizationId, supplierCreditNoteId], map: "supplier_return_credit_note_key")
  @@unique([organizationId, supplierId, supplierCreditReference], map: "supplier_return_supplier_credit_reference_key")
  @@unique([organizationId, creditJournalEntryId], map: "supplier_return_credit_journal_key")
  @@index([organizationId, purchaseId, createdAt], map: "supplier_return_purchase_idx")
  @@index([organizationId, sourceMovementId, status], map: "supplier_return_movement_idx")
  @@index([organizationId, supplierInvoiceId, status], map: "supplier_return_invoice_idx")
}


/// Immutable evidence of replacing a rejected, unposted supplier credit.
/// The return's current credit pointer is the only active financial link.
model EnterpriseSupplierReturnCreditReplacement {
  id                        String   @id @default(cuid())
  organizationId            String
  returnRequestId           String
  supplierId                String
  previousCreditNoteId      String
  previousCreditRevision    Int
  previousSupplierReference String
  replacementCreditNoteId   String
  replacementSupplierReference String
  rejectionApprovalId       String
  reason                    String
  replacedByUserId          String
  createdAt                 DateTime @default(now())
  returnRequest             EnterpriseSupplierReturnRequest @relation(fields: [organizationId, returnRequestId], references: [organizationId, id], onDelete: Restrict, map: "supplier_credit_history_return_fk")
  previousCredit            EnterpriseSupplierCreditNote @relation("SupplierReturnPreviousCredit", fields: [organizationId, previousCreditNoteId], references: [organizationId, id], onDelete: Restrict, map: "supplier_credit_history_previous_fk")
  replacementCredit         EnterpriseSupplierCreditNote @relation("SupplierReturnReplacementCredit", fields: [organizationId, replacementCreditNoteId], references: [organizationId, id], onDelete: Restrict, map: "supplier_credit_history_replacement_fk")

  @@unique([organizationId, previousCreditNoteId], map: "supplier_return_replaced_credit_key")
  @@unique([organizationId, replacementCreditNoteId], map: "supplier_return_replacement_credit_key")
  @@unique([organizationId, supplierId, previousSupplierReference], map: "supplier_return_replaced_reference_key")
  @@index([organizationId, returnRequestId, createdAt], map: "supplier_return_credit_history_idx")
}

model EnterpriseStockLotReclassification {
  id                    String   @id @default(cuid())
  organizationId        String
  reference             String
  sourceBalanceId       String
  sourceBalanceRevision Int
  inventoryItemId       String
  itemRevision          Int
  warehouseId           String
  storageLocationId     String?
  quantity              Decimal  @db.Decimal(21, 6)
  allocations           Json
  reason                String
  requestedByUserId     String
  status                String   @default("PENDING_APPROVAL")
  revision              Int      @default(1)
  idempotencyKey        String
  decidedAt             DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, reference])
  @@unique([organizationId, idempotencyKey], map: "EnterpriseLotReclass_idempotency_key")
  @@index([organizationId, sourceBalanceId, status], map: "EnterpriseLotReclass_source_status_idx")
  @@index([organizationId, warehouseId, status], map: "EnterpriseLotReclass_warehouse_status_idx")
}

 // An inspected non-sellable return is physical custody, NOT a sellable
 // inventory balance or an automatically recognized asset. Keep provenance
 // and the final disposal evidence independently of the commercial refund.
model EnterpriseInventoryReturnCustody {
  id String @id @default(cuid())
  organizationId String
  returnLineId String
  originalMovementId String
  quantity Decimal @db.Decimal(21, 6)
  disposition String
  status String
  inspectedByUserId String
  inspectedAt DateTime
  inspectionNotes String?
  registeredByUserId String
  disposalRequestedByUserId String?
  disposalRequestedAt DateTime?
  disposalReason String?
  disposedByUserId String?
  disposedAt DateTime?
  disposalEvidence String?
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  returnLine EnterpriseRetailInvoiceReturnLine @relation(fields:[organizationId,returnLineId],references:[organizationId,id],onDelete:Restrict,map:"inv_return_custody_line_fk")
  originalMovement EnterpriseStockMovement @relation(fields:[organizationId,originalMovementId],references:[organizationId,id],onDelete:Restrict,map:"inv_return_custody_movement_fk")

  recoveryAssessments EnterpriseInventoryReturnRecoveryAssessment[]

  @@unique([organizationId, id],map:"inv_return_custody_org_id_key")
  @@unique([organizationId,returnLineId,originalMovementId],map:"inv_return_custody_source_key")
  @@index([organizationId,status,createdAt],map:"inv_return_custody_status_idx")
  @@index([organizationId,originalMovementId],map:"inv_return_custody_movement_idx")
}

// Durable work cursor only; the stock ledger remains the source of truth.
model EnterpriseInventoryQualityScan {
  organizationId String @id
  nextScanAt DateTime @default(now())
  leaseUntil DateTime?
  leaseToken String?
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)

  @@index([nextScanAt,leaseUntil],map:"inventory_quality_scan_due_idx")
}

model EnterpriseInventoryReturnRecoveryAssessment {
  id String @id @default(cuid())
  organizationId String
  custodyId String
  reference String
  status String @default("PENDING_APPROVAL")
  custodyRevision Int
  quantity Decimal @db.Decimal(21, 6)
  historicalCostCeiling Decimal @db.Decimal(20,6)
  estimatedSellingAmount Decimal @db.Decimal(20,6)
  completionCost Decimal @db.Decimal(20,6)
  sellingCost Decimal @db.Decimal(20,6)
  estimatedNetValue Decimal @db.Decimal(20,6)
  proposedRecoveryAmount Decimal @db.Decimal(20,6)
  currencyCode String
  originalIssueEventId String
  originalIssueJournalId String
  evidenceReference String
  findings String
  assessedByUserId String
  assessedAt DateTime @default(now())
  decidedAt DateTime?
  withdrawnAt DateTime?
  withdrawnByUserId String?
  withdrawalReason String?
  executedAt DateTime?
  executedByUserId String?
  releaseEvidence String?
  recoveryMovementId String?
  recoveryAccountingEventId String?
  recoveryJournalEntryId String?
  revision Int @default(1)
  idempotencyKey String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  custody EnterpriseInventoryReturnCustody @relation(fields:[organizationId,custodyId],references:[organizationId,id],onDelete:Restrict,map:"inv_recovery_custody_fk")

  @@unique([organizationId,id],map:"inv_recovery_org_id_key")
  @@unique([organizationId,reference],map:"inv_recovery_reference_key")
  @@unique([organizationId,idempotencyKey],map:"inv_recovery_idempotency_key")
  @@unique([organizationId,recoveryMovementId],map:"inv_recovery_movement_key")
  @@unique([organizationId,recoveryAccountingEventId],map:"inv_recovery_event_key")
  @@unique([organizationId,recoveryJournalEntryId],map:"inv_recovery_journal_key")
  @@index([organizationId,custodyId,status],map:"inv_recovery_custody_status_idx")
}
