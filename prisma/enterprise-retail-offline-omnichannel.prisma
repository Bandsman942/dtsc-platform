model EnterpriseRetailOfflineSnapshot {
  id              String   @id @default(cuid())
  organizationId  String
  version         String
  siteId          String
  warehouseId     String
  currencyCode    String
  payloadHash     String
  itemCount       Int
  validFrom       DateTime
  validUntil      DateTime
  createdByUserId String
  createdAt       DateTime @default(now())

  @@unique([organizationId, id])
  @@unique([organizationId, version])
  @@index([organizationId, siteId, warehouseId, validUntil])
  @@index([organizationId, createdAt])
}

model EnterpriseRetailOfflineSyncOperation {
  id               String   @id @default(cuid())
  organizationId   String
  operationUuid    String
  operationType    String
  siteId            String
  warehouseId       String
  snapshotVersion   String
  payloadHash       String
  status            String   @default("RECEIVED")
  serverEntityType  String?
  serverEntityId    String?
  conflictCode      String?
  conflictJson      Json?
  receivedByUserId  String
  receivedAt        DateTime @default(now())
  syncedAt          DateTime?
  updatedAt         DateTime @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, operationUuid])
  @@index([organizationId, status, receivedAt])
  @@index([organizationId, snapshotVersion])
  @@index([organizationId, serverEntityType, serverEntityId])
}

model EnterpriseRetailCountryPackActivation {
  id                String   @id @default(cuid())
  organizationId    String
  packCode          String
  countryCode       String
  packVersion       Int
  status            String   @default("DRAFT")
  capabilitiesJson  Json
  configurationJson Json?
  evidenceJson      Json?
  activatedByUserId String
  updatedByUserId   String?
  revision          Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  archivedAt        DateTime?

  @@unique([organizationId, id])
  @@unique([organizationId, packCode])
  @@index([organizationId, countryCode, status])
  @@index([archivedAt])
}

model EnterpriseRetailOnboardingRun {
  id                     String   @id @default(cuid())
  organizationId         String
  status                 String   @default("IN_PROGRESS")
  currentStep            String   @default("COUNTRY")
  countryCode            String?
  currencyCode           String?
  siteId                 String?
  warehouseId            String?
  cashFinancialAccountId String?
  readinessJson          Json?
  blockedReason          String?
  createdByUserId        String
  updatedByUserId        String?
  revision               Int      @default(1)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  completedAt            DateTime?
  archivedAt             DateTime?

  @@unique([organizationId, id])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, countryCode, status])
  @@index([archivedAt])
}

// Retail only stores channel orchestration metadata here. The order, its lines, amounts and
// fulfillment status remain canonical in EnterpriseSalesOrder / EnterpriseFulfillment.
model EnterpriseRetailOrderOrchestration {
  id                     String   @id @default(cuid())
  organizationId         String
  salesOrderId           String
  idempotencyKey         String
  channelCode            String   @default("POS")
  fulfillmentMode        String
  sourceSiteId           String
  fulfillmentWarehouseId String
  pickupSiteId           String?
  status                 String   @default("RESERVED")
  createdByUserId        String
  updatedByUserId        String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  archivedAt             DateTime?

  @@unique([organizationId, id])
  @@unique([organizationId, salesOrderId])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, fulfillmentMode, status, createdAt])
  @@index([organizationId, sourceSiteId, fulfillmentWarehouseId])
  @@index([archivedAt])
}

// Operational return only: payment, credit note and accounting remain Finance authorities.
// A return is not financially completed until the canonical refund is confirmed.
model EnterpriseRetailOmnichannelReturn {
  id                       String   @id @default(cuid())
  organizationId           String
  salesOrderId             String
  number                   String
  idempotencyKey           String
  status                   String   @default("PENDING_APPROVAL")
  reason                   String
  currencyCode             String
  refundAmount             Decimal  @db.Decimal(20, 6)
  salesInvoiceId           String
  sourcePaymentId          String
  refundPaymentId          String?
  salesCreditNoteId        String?
  requestedByUserId        String
  validatorUserId          String
  approvedByUserId         String?
  preparedByUserId         String?
  settledByUserId          String?
  inspectedByUserId        String?
  inspectedAt              DateTime?
  inspectionNotes          String?
  decisionReason           String?
  revision                 Int      @default(1)
  approvedAt               DateTime?
  completedAt              DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  order                    EnterpriseSalesOrder @relation(fields: [organizationId, salesOrderId], references: [organizationId, id], onDelete: Restrict)
  lines                    EnterpriseRetailOmnichannelReturnLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, refundPaymentId])
  @@unique([organizationId, salesCreditNoteId])
  @@index([organizationId, salesOrderId, status])
  @@index([organizationId, validatorUserId, status, createdAt])
}

model EnterpriseRetailOmnichannelReturnLine {
  id                  String   @id @default(cuid())
  organizationId      String
  returnId            String
  salesOrderItemId    String
  quantity            Decimal  @db.Decimal(18, 3)
  refundAmount        Decimal  @db.Decimal(20, 6)
  stockDisposition    String
  productCondition    String
  createdAt           DateTime @default(now())
  retailReturn        EnterpriseRetailOmnichannelReturn @relation(fields: [organizationId, returnId], references: [organizationId, id], onDelete: Restrict)
  salesOrderItem      EnterpriseSalesOrderItem @relation(fields: [organizationId, salesOrderItemId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, returnId, salesOrderItemId])
  @@index([organizationId, salesOrderItemId])
}
