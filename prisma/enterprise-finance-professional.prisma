model EnterpriseFinanceComment {
  id             String   @id @default(cuid())
  organizationId String
  entityType     String
  entityId       String
  authorUserId   String
  content        String
  revision       Int      @default(1)
  archivedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, id])
  @@index([organizationId, entityType, entityId, archivedAt, createdAt])
  @@index([organizationId, authorUserId, archivedAt])
}
