model EnterpriseDocument {
  id               String                      @id @default(cuid())
  organizationId   String
  title            String
  description      String?
  documentType     String
  category         String?
  status           String                      @default("DRAFT")
  visibility       String                      @default("ORGANIZATION")
  ownerUserId      String?
  departmentId     String?
  currentVersion   Int                         @default(0)
  sourceModule     String?
  sourceEntityType String?
  sourceEntityId   String?
  expiresAt        DateTime?
  createdByUserId  String
  updatedByUserId  String?
  revision         Int                         @default(1)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  archivedAt       DateTime?
  versions         EnterpriseDocumentVersion[]
  access           EnterpriseDocumentAccess[]

  @@unique([organizationId, id])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, documentType, status])
  @@index([organizationId, category, status])
  @@index([organizationId, visibility, status])
  @@index([organizationId, departmentId, status])
  @@index([organizationId, ownerUserId, status])
  @@index([organizationId, expiresAt])
  @@index([organizationId, sourceEntityType, sourceEntityId])
  @@index([archivedAt])
}

model EnterpriseDocumentVersion {
  id               String             @id @default(cuid())
  organizationId   String
  documentId       String
  versionNumber    Int
  fileName         String
  mimeType         String
  sizeBytes        Int
  storageProvider  String             @default("SUPABASE")
  storageBucket    String
  storagePath      String
  checksum         String?
  uploadedByUserId String
  createdAt        DateTime           @default(now())
  document         EnterpriseDocument @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, documentId, versionNumber])
  @@unique([organizationId, id])
  @@index([organizationId, documentId, createdAt])
  @@index([organizationId, checksum])
}

model EnterpriseDocumentAccess {
  id              String             @id @default(cuid())
  organizationId  String
  documentId      String
  userId          String
  accessLevel     String             @default("READ")
  grantedByUserId String
  createdAt       DateTime           @default(now())
  document        EnterpriseDocument @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, documentId, userId])
  @@index([organizationId, userId, createdAt])
}

model EnterpriseSupplier {
  id              String                      @id @default(cuid())
  organizationId  String
  businessPartyId String?
  legalName       String
  displayName     String?
  normalizedName  String
  supplierType    String?
  category        String?
  status          String                      @default("PROSPECT")
  email           String?
  phone           String?
  website         String?
  addressLine     String?
  city            String?
  country         String?
  taxIdentifier   String?
  registrationId  String?
  paymentTerms    String?
  complianceStatus String?                    @default("NOT_REVIEWED")
  averageLeadTimeDays Int?
  notes           String?
  createdByUserId String
  updatedByUserId String?
  revision        Int                         @default(1)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  archivedAt      DateTime?
  contacts        EnterpriseSupplierContact[]
  purchases       EnterprisePurchase[]
  expenses        EnterpriseExpense[]

  @@unique([organizationId, id])
  @@unique([organizationId, normalizedName])
  @@unique([organizationId, businessPartyId])
  @@index([organizationId, status, legalName])
  @@index([organizationId, category, status])
  @@index([organizationId, country, status])
  @@index([organizationId, taxIdentifier])
  @@index([organizationId, registrationId])
  @@index([organizationId, complianceStatus, status])
  @@index([archivedAt])
}

model EnterpriseSupplierContact {
  id             String             @id @default(cuid())
  organizationId String
  supplierId     String
  name           String
  title          String?
  email          String?
  phone          String?
  isPrimary      Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  supplier       EnterpriseSupplier @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, supplierId, isPrimary])
}

model EnterprisePurchase {
  id                     String                      @id @default(cuid())
  organizationId         String
  reference              String
  title                  String
  description            String?
  status                 String                      @default("DRAFT")
  priority               String                      @default("NORMAL")
  supplierId             String?
  requestedByUserId      String
  buyerUserId            String?
  departmentId           String?
  requestId              String?
  budgetLineId           String?
  siteId                 String?
  destinationWarehouseId String?
  supplierContractId     String?
  projectId              String?
  assetId                String?
  expectedReceiptType    String                      @default("GOODS")
  currency               String                      @default("USD")
  subtotalAmount         Decimal                     @default(0) @db.Decimal(18, 2)
  taxAmount              Decimal                     @default(0) @db.Decimal(18, 2)
  totalAmount            Decimal                     @default(0) @db.Decimal(18, 2)
  expectedAt             DateTime?
  orderedAt              DateTime?
  receivedAt             DateTime?
  closedAt               DateTime?
  sourceModule           String?
  sourceEntityType       String?
  sourceEntityId         String?
  revision               Int                         @default(1)
  createdByUserId        String
  updatedByUserId        String?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  archivedAt             DateTime?
  supplier               EnterpriseSupplier?         @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  budgetLine             EnterpriseBudgetLine?       @relation(fields: [organizationId, budgetLineId], references: [organizationId, id], onDelete: Restrict)
  items                  EnterprisePurchaseItem[]
  receipts               EnterprisePurchaseReceipt[]
  expenses               EnterpriseExpense[]

  @@unique([organizationId, id])
  @@unique([organizationId, reference])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, supplierId, status])
  @@index([organizationId, departmentId, status])
  @@index([organizationId, requestedByUserId, status])
  @@index([organizationId, buyerUserId, status])
  @@index([organizationId, requestId])
  @@index([organizationId, budgetLineId, status])
  @@index([organizationId, siteId, status])
  @@index([organizationId, destinationWarehouseId, status])
  @@index([organizationId, supplierContractId])
  @@index([organizationId, projectId])
  @@index([organizationId, assetId])
  @@index([organizationId, expectedAt])
  @@index([organizationId, sourceEntityType, sourceEntityId])
  @@index([archivedAt])
}

model EnterprisePurchaseItem {
  id               String                       @id @default(cuid())
  organizationId   String
  purchaseId       String
  catalogItemId    String?
  description      String
  quantity         Decimal                      @db.Decimal(18, 3)
  unit             String
  unitOfMeasureId  String?
  unitPrice        Decimal                      @db.Decimal(18, 2)
  taxRate          Decimal                      @default(0) @db.Decimal(8, 4)
  lineSubtotal     Decimal                      @db.Decimal(18, 2)
  taxAmount        Decimal                      @db.Decimal(18, 2)
  lineTotal        Decimal                      @db.Decimal(18, 2)
  expectedItemType String                       @default("GOODS")
  sourceEntityType String?
  sourceEntityId   String?
  sortOrder        Int                          @default(0)
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  purchase         EnterprisePurchase           @relation(fields: [organizationId, purchaseId], references: [organizationId, id], onDelete: Cascade)
  catalogItem      EnterpriseCatalogItem?        @relation(fields: [organizationId, catalogItemId], references: [organizationId, id], onDelete: Restrict)
  unitOfMeasure    EnterpriseUnitOfMeasure?      @relation(fields: [organizationId, unitOfMeasureId], references: [organizationId, id], onDelete: Restrict)
  receiptItems     EnterprisePurchaseReceiptItem[]

  @@unique([organizationId, id])
  @@index([organizationId, purchaseId, sortOrder])
  @@index([organizationId, catalogItemId])
  @@index([organizationId, unitOfMeasureId])
  @@index([organizationId, sourceEntityType, sourceEntityId])
}

model EnterprisePurchaseReceipt {
  id               String                          @id @default(cuid())
  organizationId   String
  purchaseId       String
  reference        String
  status           String                          @default("POSTED")
  idempotencyKey   String?
  receivedAt       DateTime
  receivedByUserId String
  warehouseId      String?
  storageLocationId String?
  serviceAccepted  Boolean                         @default(false)
  notes            String?
  revision         Int                             @default(1)
  createdAt        DateTime                        @default(now())
  purchase         EnterprisePurchase              @relation(fields: [organizationId, purchaseId], references: [organizationId, id], onDelete: Restrict)
  items            EnterprisePurchaseReceiptItem[]

  @@unique([organizationId, id])
  @@unique([organizationId, reference])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, purchaseId, receivedAt])
  @@index([organizationId, receivedByUserId, receivedAt])
  @@index([organizationId, warehouseId, receivedAt])
}

model EnterprisePurchaseReceiptItem {
  id               String                    @id @default(cuid())
  organizationId   String
  receiptId        String
  purchaseItemId   String
  quantityReceived Decimal                   @db.Decimal(18, 3)
  stockMovementId  String?
  serviceAccepted  Boolean                   @default(false)
  createdAt        DateTime                  @default(now())
  receipt          EnterprisePurchaseReceipt @relation(fields: [organizationId, receiptId], references: [organizationId, id], onDelete: Cascade)
  purchaseItem     EnterprisePurchaseItem    @relation(fields: [organizationId, purchaseItemId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, receiptId, purchaseItemId])
  @@unique([organizationId, stockMovementId])
  @@index([organizationId, purchaseItemId])
}
