model EnterpriseDocument {
  id              String                      @id @default(cuid())
  organizationId  String
  title           String
  description     String?
  documentType    String
  category        String?
  status          String                      @default("DRAFT")
  visibility      String                      @default("ORGANIZATION")
  ownerUserId     String?
  departmentId    String?
  currentVersion  Int                         @default(0)
  sourceModule    String?
  sourceEntityType String?
  sourceEntityId  String?
  expiresAt       DateTime?
  createdByUserId String
  updatedByUserId String?
  revision        Int                         @default(1)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  archivedAt      DateTime?
  versions        EnterpriseDocumentVersion[]
  access          EnterpriseDocumentAccess[]

  @@unique([organizationId, id])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, documentType, status])
  @@index([organizationId, category, status])
  @@index([organizationId, visibility, status])
  @@index([organizationId, departmentId, status])
  @@index([organizationId, ownerUserId, status])
  @@index([organizationId, expiresAt])
  @@index([organizationId, sourceEntityType, sourceEntityId])
  @@index([archivedAt])
}

model EnterpriseDocumentVersion {
  id               String             @id @default(cuid())
  organizationId   String
  documentId       String
  versionNumber    Int
  fileName         String
  mimeType         String
  sizeBytes        Int
  storageProvider  String             @default("SUPABASE")
  storageBucket    String
  storagePath      String
  checksum         String?
  uploadedByUserId String
  createdAt        DateTime           @default(now())
  document         EnterpriseDocument @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, documentId, versionNumber])
  @@unique([organizationId, id])
  @@index([organizationId, documentId, createdAt])
  @@index([organizationId, checksum])
}

model EnterpriseDocumentAccess {
  id             String             @id @default(cuid())
  organizationId String
  documentId     String
  userId         String
  accessLevel    String             @default("READ")
  grantedByUserId String
  createdAt      DateTime           @default(now())
  document       EnterpriseDocument @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, documentId, userId])
  @@index([organizationId, userId, createdAt])
}

model EnterpriseSupplier {
  id              String                      @id @default(cuid())
  organizationId  String
  legalName       String
  displayName     String?
  normalizedName  String
  supplierType    String?
  category        String?
  status          String                      @default("PROSPECT")
  email           String?
  phone           String?
  website         String?
  addressLine     String?
  city            String?
  country         String?
  taxIdentifier   String?
  registrationId  String?
  notes           String?
  createdByUserId String
  updatedByUserId String?
  revision        Int                         @default(1)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  archivedAt      DateTime?
  contacts        EnterpriseSupplierContact[]
  purchases       EnterprisePurchase[]

  @@unique([organizationId, id])
  @@unique([organizationId, normalizedName])
  @@index([organizationId, status, legalName])
  @@index([organizationId, category, status])
  @@index([organizationId, country, status])
  @@index([organizationId, taxIdentifier])
  @@index([organizationId, registrationId])
  @@index([archivedAt])
}

model EnterpriseSupplierContact {
  id             String             @id @default(cuid())
  organizationId String
  supplierId     String
  name           String
  title          String?
  email          String?
  phone          String?
  isPrimary      Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  supplier       EnterpriseSupplier @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, supplierId, isPrimary])
}

model EnterprisePurchase {
  id                String                      @id @default(cuid())
  organizationId    String
  reference         String
  title             String
  description       String?
  status            String                      @default("DRAFT")
  priority          String                      @default("NORMAL")
  supplierId        String?
  requestedByUserId String
  buyerUserId       String?
  departmentId      String?
  requestId         String?
  currency          String                      @default("USD")
  subtotalAmount    Decimal                     @default(0) @db.Decimal(18, 2)
  taxAmount         Decimal                     @default(0) @db.Decimal(18, 2)
  totalAmount       Decimal                     @default(0) @db.Decimal(18, 2)
  expectedAt        DateTime?
  orderedAt         DateTime?
  receivedAt        DateTime?
  closedAt          DateTime?
  sourceModule      String?
  sourceEntityType  String?
  sourceEntityId    String?
  revision          Int                         @default(1)
  createdByUserId   String
  updatedByUserId   String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  archivedAt        DateTime?
  supplier          EnterpriseSupplier?         @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  items             EnterprisePurchaseItem[]
  receipts          EnterprisePurchaseReceipt[]

  @@unique([organizationId, id])
  @@unique([organizationId, reference])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, supplierId, status])
  @@index([organizationId, departmentId, status])
  @@index([organizationId, requestedByUserId, status])
  @@index([organizationId, buyerUserId, status])
  @@index([organizationId, requestId])
  @@index([organizationId, expectedAt])
  @@index([organizationId, sourceEntityType, sourceEntityId])
  @@index([archivedAt])
}

model EnterprisePurchaseItem {
  id               String             @id @default(cuid())
  organizationId   String
  purchaseId       String
  description      String
  quantity         Decimal            @db.Decimal(18, 3)
  unit             String
  unitPrice        Decimal            @db.Decimal(18, 2)
  taxRate          Decimal            @default(0) @db.Decimal(8, 4)
  lineSubtotal     Decimal            @db.Decimal(18, 2)
  taxAmount        Decimal            @db.Decimal(18, 2)
  lineTotal        Decimal            @db.Decimal(18, 2)
  sourceEntityType String?
  sourceEntityId   String?
  sortOrder        Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  purchase         EnterprisePurchase @relation(fields: [organizationId, purchaseId], references: [organizationId, id], onDelete: Cascade)
  receiptItems     EnterprisePurchaseReceiptItem[]

  @@unique([organizationId, id])
  @@index([organizationId, purchaseId, sortOrder])
  @@index([organizationId, sourceEntityType, sourceEntityId])
}

model EnterprisePurchaseReceipt {
  id               String                         @id @default(cuid())
  organizationId   String
  purchaseId       String
  reference        String
  receivedAt       DateTime
  receivedByUserId String
  notes            String?
  createdAt        DateTime                       @default(now())
  purchase         EnterprisePurchase             @relation(fields: [organizationId, purchaseId], references: [organizationId, id], onDelete: Restrict)
  items            EnterprisePurchaseReceiptItem[]

  @@unique([organizationId, id])
  @@unique([organizationId, reference])
  @@index([organizationId, purchaseId, receivedAt])
  @@index([organizationId, receivedByUserId, receivedAt])
}

model EnterprisePurchaseReceiptItem {
  id               String                    @id @default(cuid())
  organizationId   String
  receiptId        String
  purchaseItemId   String
  quantityReceived Decimal                   @db.Decimal(18, 3)
  createdAt        DateTime                  @default(now())
  receipt          EnterprisePurchaseReceipt @relation(fields: [organizationId, receiptId], references: [organizationId, id], onDelete: Cascade)
  purchaseItem     EnterprisePurchaseItem    @relation(fields: [organizationId, purchaseItemId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, receiptId, purchaseItemId])
  @@index([organizationId, purchaseItemId])
}
