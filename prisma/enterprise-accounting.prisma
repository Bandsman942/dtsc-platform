model EnterpriseFinanceConfiguration {
  id                            String   @id @default(cuid())
  organizationId                String   @unique
  functionalCurrencyCode        String
  presentationCurrencyCode      String?
  inventoryValuationMethod      String   @default("WEIGHTED_AVERAGE")
  numberingPolicyJson           Json?
  taxPolicyJson                 Json?
  reconciliationTolerance       Decimal  @default(0.01) @db.Decimal(20, 6)
  defaultAccountsJson           Json?
  closePolicyJson               Json?
  approvalThresholdsJson        Json?
  readinessStatus               String   @default("DRAFT")
  automaticPostingEnabled       Boolean  @default(false)
  createdByUserId               String
  updatedByUserId               String?
  lockedFunctionalCurrencyAt    DateTime?
  revision                      Int      @default(1)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@index([organizationId, readinessStatus])
}

model EnterpriseFiscalYear {
  id              String                   @id @default(cuid())
  organizationId  String
  code            String
  startDate       DateTime
  endDate         DateTime
  status          String                   @default("DRAFT")
  createdByUserId String
  openedAt        DateTime?
  closedAt        DateTime?
  revision        Int                      @default(1)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  periods         EnterpriseFiscalPeriod[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, startDate, endDate])
}

model EnterpriseFiscalPeriod {
  id              String                     @id @default(cuid())
  organizationId  String
  fiscalYearId    String
  code            String
  startDate       DateTime
  endDate         DateTime
  status          String                     @default("OPEN")
  softClosedAt    DateTime?
  closedAt        DateTime?
  lockedAt        DateTime?
  reopenedAt      DateTime?
  reopenedReason  String?
  createdByUserId String
  updatedByUserId String?
  revision        Int                        @default(1)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  fiscalYear      EnterpriseFiscalYear       @relation(fields: [organizationId, fiscalYearId], references: [organizationId, id], onDelete: Restrict)
  journalEntries         EnterpriseJournalEntry[]
  closes                 EnterpriseFinancialClose[]
  openingBalanceImports EnterpriseOpeningBalanceImport[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, startDate, endDate])
}

model EnterpriseFinancialClose {
  id                String                 @id @default(cuid())
  organizationId    String
  fiscalPeriodId    String
  status            String                 @default("DRAFT")
  checklistJson     Json
  blockersJson      Json?
  requestedByUserId String
  approvedByUserId  String?
  closedByUserId    String?
  requestedAt       DateTime?
  approvedAt        DateTime?
  closedAt          DateTime?
  reopenedAt        DateTime?
  reopenReason      String?
  revision          Int                    @default(1)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  fiscalPeriod      EnterpriseFiscalPeriod @relation(fields: [organizationId, fiscalPeriodId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, fiscalPeriodId, status])
}

model EnterpriseChartOfAccounts {
  id              String                   @id @default(cuid())
  organizationId  String
  code            String
  nameFr          String
  nameEn          String
  status          String                   @default("DRAFT")
  templateCode    String?
  createdByUserId String
  revision        Int                      @default(1)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  groups          EnterpriseAccountGroup[]
  accounts        EnterpriseLedgerAccount[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model EnterpriseAccountGroup {
  id             String                    @id @default(cuid())
  organizationId String
  chartId        String
  code           String
  nameFr         String
  nameEn         String
  accountType    String
  parentGroupId  String?
  sortOrder      Int                       @default(0)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  chart          EnterpriseChartOfAccounts @relation(fields: [organizationId, chartId], references: [organizationId, id], onDelete: Restrict)
  parent         EnterpriseAccountGroup?   @relation("EnterpriseAccountGroupHierarchy", fields: [organizationId, parentGroupId], references: [organizationId, id], onDelete: Restrict)
  children       EnterpriseAccountGroup[]  @relation("EnterpriseAccountGroupHierarchy")
  accounts       EnterpriseLedgerAccount[]

  @@unique([organizationId, id])
  @@unique([organizationId, chartId, code])
  @@index([organizationId, chartId, accountType])
}

model EnterpriseLedgerAccount {
  id                     String                    @id @default(cuid())
  organizationId         String
  chartId                String
  accountGroupId         String?
  code                   String
  nameFr                 String
  nameEn                 String
  accountType            String
  accountSubtype         String?
  parentId               String?
  level                  Int                       @default(1)
  currencyCode           String?
  isControlAccount       Boolean                   @default(false)
  isSystemAccount        Boolean                   @default(false)
  allowDirectPosting     Boolean                   @default(true)
  isActive               Boolean                   @default(true)
  archivedAt             DateTime?
  revision               Int                       @default(1)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  chart                  EnterpriseChartOfAccounts @relation(fields: [organizationId, chartId], references: [organizationId, id], onDelete: Restrict)
  group                  EnterpriseAccountGroup?   @relation(fields: [organizationId, accountGroupId], references: [organizationId, id], onDelete: Restrict)
  parent                 EnterpriseLedgerAccount?  @relation("EnterpriseLedgerAccountHierarchy", fields: [organizationId, parentId], references: [organizationId, id], onDelete: Restrict)
  children               EnterpriseLedgerAccount[] @relation("EnterpriseLedgerAccountHierarchy")
  journalLines           EnterpriseJournalLine[]
  financialAccounts      EnterpriseFinancialAccount[]
  accountMappings        EnterpriseAccountMapping[]
  openingBalanceLines    EnterpriseOpeningBalanceLine[]
  taxCodesPayable        EnterpriseTaxCode[] @relation("EnterpriseTaxCodePayableAccount")
  taxCodesRecoverable    EnterpriseTaxCode[] @relation("EnterpriseTaxCodeRecoverableAccount")

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, chartId, accountType])
  @@index([organizationId, accountSubtype, isActive])
  @@index([organizationId, parentId])
}

model EnterpriseAccountMapping {
  id                  String   @id @default(cuid())
  organizationId      String
  mappingKey          String
  ledgerAccountId     String
  sourceModule        String?
  sourceEntityType    String?
  effectiveFrom       DateTime?
  effectiveTo         DateTime?
  isActive             Boolean  @default(true)
  createdByUserId     String
  revision            Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  ledgerAccount       EnterpriseLedgerAccount @relation(fields: [organizationId, ledgerAccountId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, mappingKey, effectiveFrom])
  @@index([organizationId, ledgerAccountId, isActive])
}

model EnterpriseJournal {
  id              String                   @id @default(cuid())
  organizationId  String
  code            String
  nameFr          String
  nameEn          String
  journalType     String
  sequencePrefix  String?
  isActive        Boolean                  @default(true)
  requiresApproval Boolean                 @default(false)
  createdByUserId String
  revision        Int                      @default(1)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  entries         EnterpriseJournalEntry[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, journalType, isActive])
}

model EnterprisePostingBatch {
  id                  String   @id @default(cuid())
  organizationId      String
  reference           String
  postingEvent        String
  sourceEntityType    String
  sourceEntityId      String
  postingVersion      Int      @default(1)
  idempotencyKey      String
  status              String   @default("PENDING")
  errorCode           String?
  errorMessage        String?
  createdByUserId     String
  completedAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, sourceEntityType, sourceEntityId, postingEvent, postingVersion])
  @@index([organizationId, status, createdAt])
}

model EnterpriseJournalEntry {
  id                       String                   @id @default(cuid())
  organizationId           String
  number                   String
  journalId                String
  fiscalPeriodId           String
  accountingDate           DateTime
  documentDate             DateTime?
  reference                String?
  description              String
  sourceModule             String?
  sourceEntityType         String?
  sourceEntityId           String?
  postingEvent             String?
  postingVersion           Int                      @default(1)
  idempotencyKey           String?
  status                   String                   @default("DRAFT")
  totalDebit               Decimal                  @default(0) @db.Decimal(20, 6)
  totalCredit              Decimal                  @default(0) @db.Decimal(20, 6)
  functionalCurrencyCode   String
  preparedByUserId         String
  approvedByUserId         String?
  postedByUserId           String?
  postedAt                 DateTime?
  reversedAt               DateTime?
  reversalOfEntryId        String?
  revision                 Int                      @default(1)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  journal                  EnterpriseJournal        @relation(fields: [organizationId, journalId], references: [organizationId, id], onDelete: Restrict)
  fiscalPeriod             EnterpriseFiscalPeriod   @relation(fields: [organizationId, fiscalPeriodId], references: [organizationId, id], onDelete: Restrict)
  reversalOf               EnterpriseJournalEntry?  @relation("EnterpriseJournalEntryReversal", fields: [organizationId, reversalOfEntryId], references: [organizationId, id], onDelete: Restrict)
  reversals                EnterpriseJournalEntry[] @relation("EnterpriseJournalEntryReversal")
  reversalRecordsAsOriginal EnterpriseJournalReversal[] @relation("EnterpriseJournalReversalOriginal")
  reversalRecordsAsResult  EnterpriseJournalReversal[] @relation("EnterpriseJournalReversalResult")
  lines                    EnterpriseJournalLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, accountingDate])
  @@index([organizationId, journalId, accountingDate])
  @@index([organizationId, sourceEntityType, sourceEntityId])
}

model EnterpriseJournalLine {
  id                       String                  @id @default(cuid())
  organizationId           String
  journalEntryId           String
  ledgerAccountId          String
  businessPartyId          String?
  projectId                String?
  departmentId             String?
  siteId                   String?
  assetId                  String?
  inventoryItemId          String?
  description              String?
  debit                    Decimal                 @default(0) @db.Decimal(20, 6)
  credit                   Decimal                 @default(0) @db.Decimal(20, 6)
  transactionCurrencyCode  String?
  transactionAmount        Decimal?                @db.Decimal(20, 6)
  exchangeRate             Decimal?                @db.Decimal(24, 12)
  functionalAmount         Decimal                 @db.Decimal(20, 6)
  analyticReference        String?
  createdAt                DateTime                @default(now())
  journalEntry             EnterpriseJournalEntry  @relation(fields: [organizationId, journalEntryId], references: [organizationId, id], onDelete: Cascade)
  ledgerAccount            EnterpriseLedgerAccount @relation(fields: [organizationId, ledgerAccountId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, journalEntryId])
  @@index([organizationId, ledgerAccountId])
  @@index([organizationId, businessPartyId])
  @@index([organizationId, projectId])
}

model EnterpriseJournalReversal {
  id                    String   @id @default(cuid())
  organizationId        String
  originalEntryId       String
  reversalEntryId       String
  reason                String
  requestedByUserId     String
  approvedByUserId      String?
  createdAt             DateTime @default(now())
  originalEntry         EnterpriseJournalEntry @relation("EnterpriseJournalReversalOriginal", fields: [organizationId, originalEntryId], references: [organizationId, id], onDelete: Restrict)
  reversalEntry         EnterpriseJournalEntry @relation("EnterpriseJournalReversalResult", fields: [organizationId, reversalEntryId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, originalEntryId])
  @@unique([organizationId, reversalEntryId])
}

model EnterpriseCurrency {
  id             String   @id @default(cuid())
  organizationId String?
  code           String
  name           String
  symbol         String?
  precision      Int      @default(2)
  roundingMode   String   @default("HALF_UP")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([code, isActive])
}

model EnterpriseExchangeRate {
  id                 String   @id @default(cuid())
  organizationId     String
  sourceCurrencyCode String
  targetCurrencyCode String
  rateDate           DateTime
  source             String
  rate               Decimal  @db.Decimal(24, 12)
  precision          Int      @default(12)
  status             String   @default("ACTIVE")
  createdByUserId    String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([organizationId, sourceCurrencyCode, targetCurrencyCode, rateDate, source])
  @@index([organizationId, rateDate, status])
}

model EnterpriseExchangeRateSnapshot {
  id                 String   @id @default(cuid())
  organizationId     String
  sourceEntityType   String
  sourceEntityId     String
  sourceCurrencyCode String
  targetCurrencyCode String
  rate               Decimal  @db.Decimal(24, 12)
  rateDate           DateTime
  source             String
  createdAt          DateTime @default(now())

  @@unique([organizationId, sourceEntityType, sourceEntityId, sourceCurrencyCode, targetCurrencyCode])
  @@index([organizationId, rateDate])
}

model EnterpriseSalesInvoice {
