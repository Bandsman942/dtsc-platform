  organizationId        String
  number                String
  businessPartyId       String
  salesOrderId          String?
  fulfillmentId         String?
  contractId            String?
  projectId             String?
  status                String                       @default("DRAFT")
  invoiceDate           DateTime
  dueDate               DateTime?
  currencyCode          String
  subtotal              Decimal                      @db.Decimal(20, 6)
  discountTotal         Decimal                      @default(0) @db.Decimal(20, 6)
  taxTotal              Decimal                      @default(0) @db.Decimal(20, 6)
  grandTotal            Decimal                      @db.Decimal(20, 6)
  amountPaid            Decimal                      @default(0) @db.Decimal(20, 6)
  amountCredited        Decimal                      @default(0) @db.Decimal(20, 6)
  outstandingAmount     Decimal                      @db.Decimal(20, 6)
